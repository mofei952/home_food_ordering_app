{
  "openapi": "3.1.0",
  "info": {
    "title": "家庭点菜 API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/households": {
      "post": {
        "summary": "Create Household",
        "operationId": "create_household_api_households_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateHouseholdRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateHouseholdResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/households/join": {
      "post": {
        "summary": "Join Household",
        "operationId": "join_household_api_households_join_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JoinHouseholdRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/session": {
      "get": {
        "summary": "Get Current Session",
        "operationId": "get_current_session_api_session_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete Current Session",
        "operationId": "delete_current_session_api_session_delete",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        }
      }
    },
    "/api/households/invite/rotate": {
      "post": {
        "summary": "Rotate Invite",
        "operationId": "rotate_invite_api_households_invite_rotate_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RotateInviteResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/households/members/{member_id}/disable": {
      "post": {
        "summary": "Disable Member",
        "operationId": "disable_member_api_households_members__member_id__disable_post",
        "parameters": [
          {
            "name": "member_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Member Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberSummary"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/households/members/{member_id}/pin/reset": {
      "post": {
        "summary": "Reset Member Pin",
        "operationId": "reset_member_pin_api_households_members__member_id__pin_reset_post",
        "parameters": [
          {
            "name": "member_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Member Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPinRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberSummary"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Api Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthResponse": {
        "properties": {
          "household": {
            "$ref": "#/components/schemas/HouseholdSummary"
          },
          "member": {
            "$ref": "#/components/schemas/MemberSummary"
          }
        },
        "type": "object",
        "required": [
          "household",
          "member"
        ],
        "title": "AuthResponse"
      },
      "CreateHouseholdRequest": {
        "properties": {
          "household_name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Household Name"
          },
          "owner_name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Owner Name"
          },
          "pin": {
            "type": "string",
            "pattern": "^\\d{4,6}$",
            "title": "Pin"
          },
          "timezone": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Timezone"
          }
        },
        "type": "object",
        "required": [
          "household_name",
          "owner_name",
          "pin",
          "timezone"
        ],
        "title": "CreateHouseholdRequest"
      },
      "CreateHouseholdResponse": {
        "properties": {
          "household": {
            "$ref": "#/components/schemas/HouseholdSummary"
          },
          "member": {
            "$ref": "#/components/schemas/MemberSummary"
          },
          "invite_code": {
            "type": "string",
            "title": "Invite Code"
          }
        },
        "type": "object",
        "required": [
          "household",
          "member",
          "invite_code"
        ],
        "title": "CreateHouseholdResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HouseholdSummary": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "timezone": {
            "type": "string",
            "title": "Timezone"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "timezone"
        ],
        "title": "HouseholdSummary"
      },
      "JoinHouseholdRequest": {
        "properties": {
          "invite_code": {
            "type": "string",
            "pattern": "^[23456789ABCDEFGHJKLMNPQRSTUVWXYZ]{8}$",
            "title": "Invite Code"
          },
          "nickname": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Nickname"
          },
          "pin": {
            "type": "string",
            "pattern": "^\\d{4,6}$",
            "title": "Pin"
          }
        },
        "type": "object",
        "required": [
          "invite_code",
          "nickname",
          "pin"
        ],
        "title": "JoinHouseholdRequest"
      },
      "MemberSummary": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "nickname": {
            "type": "string",
            "title": "Nickname"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "member"
            ],
            "title": "Role"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "disabled"
            ],
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "id",
          "nickname",
          "role",
          "status"
        ],
        "title": "MemberSummary"
      },
      "ResetPinRequest": {
        "properties": {
          "pin": {
            "type": "string",
            "pattern": "^\\d{4,6}$",
            "title": "Pin"
          }
        },
        "type": "object",
        "required": [
          "pin"
        ],
        "title": "ResetPinRequest"
      },
      "RotateInviteResponse": {
        "properties": {
          "invite_code": {
            "type": "string",
            "title": "Invite Code"
          }
        },
        "type": "object",
        "required": [
          "invite_code"
        ],
        "title": "RotateInviteResponse"
      },
      "SessionResponse": {
        "properties": {
          "household": {
            "$ref": "#/components/schemas/HouseholdSummary"
          },
          "member": {
            "$ref": "#/components/schemas/MemberSummary"
          },
          "members": {
            "items": {
              "$ref": "#/components/schemas/MemberSummary"
            },
            "type": "array",
            "title": "Members"
          }
        },
        "type": "object",
        "required": [
          "household",
          "member",
          "members"
        ],
        "title": "SessionResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
