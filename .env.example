DATABASE_URL=postgresql+asyncpg://family_menu:family_menu@localhost:5432/family_menu
ENVIRONMENT=development

# Cookie Secure flag. When unset, Secure is off only for ENVIRONMENT=development.
# Local Compose serves plain HTTP on :8080 — set false so mobile browsers keep the session cookie.
# SECURE_COOKIES=false

# Trust X-Forwarded-For / X-Real-IP when behind Caddy/nginx (Compose sets this true).
# TRUSTED_PROXY_HEADERS=true

# Image storage backend: "s3" (default) or "memory" (explicit local/tests without MinIO).
# IMAGE_STORAGE=memory
# Production with IMAGE_STORAGE=s3 requires S3_ENDPOINT_URL (no silent memory fallback).
# Development/test may fall back to memory with a warning if S3_ENDPOINT_URL is unset.
# Local compose starts MinIO; minio-init creates the S3_BUCKET (family-menu).
IMAGE_STORAGE=s3
# SDK / put-object endpoint (Docker network hostname inside Compose: http://minio:9000)
S3_ENDPOINT_URL=http://localhost:9000
# Browser-facing host for presigned GET URLs (Compose: http://127.0.0.1:9000). Defaults to S3_ENDPOINT_URL.
# S3_PUBLIC_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=family-menu
S3_REGION=us-east-1

# Playwright local e2e (default path in scripts/verify.sh)
# DATABASE_URL=sqlite+aiosqlite:////tmp/family-menu-e2e.db
# IMAGE_STORAGE=memory
# E2E_RANDOM_SEED=42
# VITE_E2E_RANDOM_SEED=42
# Opt-in Compose e2e / smoke (requires Docker):
# E2E_USE_COMPOSE=1
# COMPOSE_SMOKE=1
